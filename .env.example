# Public canonical/local origin. Use https://bookmyroom.site in production.
APP_ORIGIN=http://localhost:3000

# Use an isolated database per environment. Production must support transactions.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=book_my_room_local

# Base64-encoded 32-byte AES key for encrypting queued verification/reset deliveries at rest.
# Generate outside source control and inject a different secret per environment.
IDENTITY_TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# ImageKit server credentials and HTTPS delivery endpoint. Never expose the private key.
IMAGEKIT_PUBLIC_KEY=replace_with_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=replace_with_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_with_path
